  "query": "\n            UPDATE device_codes\n            SET user_id = $1, status = 'authorized'\n            WHERE user_code = $2\n              AND status = 'pending'\n              AND expires_at > now()\n            RETURNING device_code, user_code, user_id, status, expires_at, created_at\n            ",
