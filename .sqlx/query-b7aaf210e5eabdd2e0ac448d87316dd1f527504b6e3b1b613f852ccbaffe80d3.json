  "query": "\n        SELECT\n            sv.id, sv.version, sv.download_url, sv.file_hash,\n            s.id as shader_id, s.slug as shader_slug, s.name as shader_name\n        FROM shader_versions sv\n        JOIN shaders s ON s.id = sv.shader_id\n        WHERE sv.id = $1\n        ",
