  "query": "\n            UPDATE shaders SET\n                name = COALESCE($1, name),\n                slug = COALESCE($2, slug),\n                description = COALESCE($3, description),\n                modrinth_id = COALESCE($4, modrinth_id),\n                curseforge_id = COALESCE($5, curseforge_id),\n                website_url = COALESCE($6, website_url),\n                updated_at = now()\n            WHERE id = $7\n            RETURNING *\n            ",
