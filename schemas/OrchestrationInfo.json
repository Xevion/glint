{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrchestrationInfo",
  "type": "object",
  "properties": {
    "completed_at": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "run_id": {
      "description": "Run ID from the run definition (None for interactive captures)",
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/OrchestrationStatus"
    },
    "total_sessions": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "started_at",
    "completed_at",
    "total_sessions",
    "status"
  ],
  "$defs": {
    "OrchestrationStatus": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED"
      ]
    }
  }
}