  "query": "\n            INSERT INTO shader_authors (id, shader_id, name, slug, url, platform)\n            VALUES ($1, $2, $3, $4, $5, $6)\n            ON CONFLICT (shader_id, name, platform) DO UPDATE SET\n                url = COALESCE(EXCLUDED.url, shader_authors.url),\n                slug = EXCLUDED.slug\n            RETURNING *\n            ",
