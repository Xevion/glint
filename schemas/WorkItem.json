{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkItem",
  "description": "A single work item: one (shader_version, scene, preset, profile) tuple to capture",
  "type": "object",
  "properties": {
    "preset": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkPreset"
        },
        {
          "type": "null"
        }
      ]
    },
    "scene": {
      "$ref": "#/$defs/WorkScene"
    },
    "scene_package": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkPackage"
        },
        {
          "type": "null"
        }
      ]
    },
    "shader": {
      "$ref": "#/$defs/WorkShader"
    }
  },
  "required": [
    "shader",
    "scene"
  ],
  "$defs": {
    "WorkPackage": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "hash"
      ]
    },
    "WorkPreset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "moon_phase": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "time_of_day_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "weather": {
          "type": [
            "string",
            "null"
          ]
        },
        "weather_intensity": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "id",
        "name",
        "slug"
      ]
    },
    "WorkScene": {
      "type": "object",
      "properties": {
        "biome": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimension": {
          "type": "string"
        },
        "fov": {
          "type": "integer",
          "format": "int32"
        },
        "id": {
          "type": "string"
        },
        "minecraft_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "moon_phase": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "name": {
          "type": "string"
        },
        "pitch": {
          "type": "number",
          "format": "double"
        },
        "render_distance": {
          "type": "integer",
          "format": "int32"
        },
        "slug": {
          "type": "string"
        },
        "time_of_day_ticks": {
          "type": "integer",
          "format": "int32"
        },
        "version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "weather": {
          "type": "string"
        },
        "weather_intensity": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "yaw": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "dimension",
        "x",
        "y",
        "z",
        "yaw",
        "pitch",
        "time_of_day_ticks",
        "weather",
        "weather_intensity",
        "fov",
        "render_distance"
      ]
    },
    "WorkShader": {
      "type": "object",
      "properties": {
        "download_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "profile_display_name": {
          "description": "Human-readable profile name (e.g. \"High\", \"Ultra\"). Used for display in the UI.",
          "type": [
            "string",
            "null"
          ]
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_name": {
          "description": "Internal profile identifier (e.g. \"HIGH\", \"ULTRA\"). Used by the mod to load Iris profiles.",
          "type": [
            "string",
            "null"
          ]
        },
        "slug": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "id",
        "slug",
        "name",
        "version"
      ]
    }
  }
}