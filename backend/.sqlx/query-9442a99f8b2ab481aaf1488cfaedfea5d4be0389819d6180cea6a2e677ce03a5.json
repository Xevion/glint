  "query": "\n            UPDATE scene_presets SET\n                name = COALESCE($2, name),\n                time_of_day_ticks = COALESCE($3, time_of_day_ticks),\n                weather = COALESCE($4, weather),\n                weather_intensity = COALESCE($5, weather_intensity),\n                moon_phase = COALESCE($6, moon_phase),\n                updated_at = now()\n            WHERE id = $1\n            RETURNING *\n            ",
