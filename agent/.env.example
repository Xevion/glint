# Glint Agent Configuration

# Backend API Configuration
GLINT_API_URL=http://localhost:8080
GLINT_API_KEY=dev-agent-key

# Agent Identification
GLINT_AGENT_ID=agent-local-dev

# Minecraft Configuration
# Path to Minecraft instance directory (contains saves/, shaderpacks/, mods/, etc.)
# For development, this should point to the mod's run directory
GLINT_MC_DIR=mod/fabric/run

# Java executable (use 'java' if in PATH, or full path)
GLINT_JAVA_PATH=java

# Minecraft Launcher
# For development with Gradle, this is the gradlew script
GLINT_MC_LAUNCHER=./mod/gradlew

# Polling & Heartbeat
GLINT_POLL_INTERVAL=30
GLINT_HEARTBEAT_INTERVAL=30

# Logging
RUST_LOG=info,glint_agent=debug
