# Database Configuration
# Relative paths resolve from backend/ directory
DATABASE_URL=sqlite:glint.db

# Server Configuration
HOST=127.0.0.1
PORT=8080

# CORS Origins (comma-separated, empty for no CORS)
# Development default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Logging
RUST_LOG=info,glint_backend=debug

# R2/S3 Storage Configuration
# R2_ACCOUNT_ID=your_account_id
# R2_BUCKET=glint
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_PUBLIC_URL=https://cdn.glint.example.com
