{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                u.id as user_id,\n                u.discord_id,\n                u.discord_username,\n                u.discord_avatar,\n                u.role as \"role: Role\",\n                u.created_at as user_created_at,\n                u.updated_at as user_updated_at,\n                s.token,\n                s.expires_at,\n                s.created_at as session_created_at\n            FROM sessions s\n            JOIN users u ON u.id = s.user_id\n            WHERE s.token = $1 AND s.expires_at > now()\n            ",
