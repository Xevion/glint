{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrepareUploadRequest",
  "description": "Request to prepare upload URLs",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PrepareUploadFile"
      }
    }
  },
  "required": [
    "files"
  ],
  "$defs": {
    "PrepareUploadFile": {
      "description": "A file entry in a prepare-upload request, with metadata for R2 key generation.",
      "type": "object",
      "properties": {
        "local_path": {
          "type": "string"
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scene_id": {
          "type": "string"
        }
      },
      "required": [
        "local_path",
        "scene_id"
      ]
    }
  }
}