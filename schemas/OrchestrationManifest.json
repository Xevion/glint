{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrchestrationManifest",
  "description": "The manifest.json output by the Minecraft mod",
  "type": "object",
  "properties": {
    "orchestration": {
      "$ref": "#/$defs/OrchestrationInfo"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaptureSessionData"
      }
    }
  },
  "required": [
    "orchestration",
    "sessions"
  ],
  "$defs": {
    "Camera": {
      "type": "object",
      "properties": {
        "pitch": {
          "type": "number",
          "format": "double"
        },
        "yaw": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "yaw",
        "pitch"
      ]
    },
    "CaptureEntry": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "resolution": {
          "$ref": "#/$defs/Resolution"
        },
        "shader": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShaderMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "timestamp",
        "resolution"
      ]
    },
    "CaptureSessionData": {
      "type": "object",
      "properties": {
        "captures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptureEntry"
          }
        },
        "completed_at": {
          "type": "string"
        },
        "minecraft": {
          "$ref": "#/$defs/MinecraftInfo"
        },
        "scene_id": {
          "type": "string"
        },
        "session_dir": {
          "type": "string"
        },
        "shaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "started_at": {
          "type": "string"
        },
        "total_captures": {
          "type": "integer",
          "format": "int32"
        },
        "world_name": {
          "type": "string"
        }
      },
      "required": [
        "world_name",
        "scene_id",
        "session_dir",
        "started_at",
        "completed_at",
        "total_captures",
        "shaders",
        "minecraft",
        "captures"
      ]
    },
    "MinecraftInfo": {
      "type": "object",
      "properties": {
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/Camera"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimension": {
          "type": [
            "string",
            "null"
          ]
        },
        "iris_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ]
    },
    "OrchestrationInfo": {
      "type": "object",
      "properties": {
        "completed_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "run_id": {
          "description": "Run ID from the run definition (None for interactive captures)",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/OrchestrationStatus"
        },
        "total_sessions": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "id",
        "started_at",
        "completed_at",
        "total_sessions",
        "status"
      ]
    },
    "OrchestrationStatus": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "Position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "int32"
        },
        "width": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "ShaderMetadata": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "filename",
        "id",
        "version"
      ]
    }
  }
}