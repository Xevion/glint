# Database Configuration
# Run `just db` to start PostgreSQL + MinIO via docker compose
DATABASE_URL=postgresql://glint:glint@localhost:59490/glint

# Server Configuration
HOST=127.0.0.1
PORT=8080

# CORS Origins (comma-separated)
# Default: http://localhost:5173,http://localhost:8080
# GLINT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Logging
RUST_LOG=info,glint=debug

# R2/S3 Storage — production (Cloudflare R2)
# GLINT_R2_ACCOUNT_ID=your_account_id
# GLINT_R2_BUCKET=glint
# GLINT_R2_ACCESS_KEY_ID=your_access_key
# GLINT_R2_SECRET_ACCESS_KEY=your_secret_key
# GLINT_R2_PUBLIC_URL=https://cdn.glint.xevion.dev

# R2/S3 Storage — local MinIO (started by `just db`)
# GLINT_R2_ENDPOINT=http://localhost:9000
# GLINT_R2_BUCKET=glint
# GLINT_R2_ACCESS_KEY_ID=minioadmin
# GLINT_R2_SECRET_ACCESS_KEY=minioadmin
# GLINT_R2_PUBLIC_URL=http://localhost:9000/glint

# Discord OAuth Configuration
# Get these from https://discord.com/developers/applications
# GLINT_DISCORD_CLIENT_ID=your_client_id
# GLINT_DISCORD_CLIENT_SECRET=your_client_secret
# GLINT_DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# PostHog Analytics Configuration
# GLINT_POSTHOG_API_KEY=phc_your_project_api_key
# GLINT_POSTHOG_HOST=https://observe.xevion.dev
