{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.3",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "concurrently -n prettier,eslint,stylelint -c blue,yellow,green \"prettier --check .\" \"eslint --cache .\" \"stylelint '**/*.{css,svelte}'\"",
		"lint:fix": "concurrently -n prettier,eslint,stylelint -c blue,yellow,green \"prettier --write .\" \"eslint --cache --fix .\" \"stylelint --fix '**/*.{css,svelte}'\"",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "vitest run",
		"test:unit:ui": "vitest --ui",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,md}": [
			"prettier --write"
		],
		"*.{js,ts,svelte}": [
			"eslint --fix"
		],
		"*.{css,svelte}": [
			"stylelint --fix"
		]
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@inlang/paraglide-js": "^2.6.0",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@testing-library/svelte": "^5.2.10",
		"@types/node": "^24",
		"@vitest/browser": "^4.0.16",
		"@vitest/browser-playwright": "^4.0.16",
		"@vitest/ui": "^4.0.16",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"lint-staged": "^16.2.7",
		"phosphor-svelte": "^3.0.1",
		"playwright": "^1.57.0",
		"postcss-html": "^1.8.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"stylelint": "^16.26.1",
		"stylelint-config-html": "^1.1.0",
		"stylelint-config-recommended": "^17.0.0",
		"stylelint-config-standard": "^39.0.1",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "latest",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.16"
	},
	"dependencies": {
		"@careswitch/svelte-data-table": "^0.6.3",
		"class-variance-authority": "^0.7.1",
		"fflate": "^0.8.2",
		"lucide-svelte": "^0.562.0",
		"overlayscrollbars": "^2.13.0",
		"overlayscrollbars-svelte": "^0.5.5",
		"svelte-relative-time": "^0.0.6",
		"true-myth": "^9.3.1"
	}
}
