{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkItem",
  "description": "A single work item: one (shader_version, scene, profile) triple to capture",
  "type": "object",
  "properties": {
    "download_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "file_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scene_biome": {
      "type": [
        "string",
        "null"
      ]
    },
    "scene_dimension": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "scene_moon_phase": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32"
    },
    "scene_name": {
      "type": "string"
    },
    "scene_pitch": {
      "type": "number",
      "format": "double"
    },
    "scene_slug": {
      "type": "string"
    },
    "scene_time_of_day_ticks": {
      "type": "integer",
      "format": "int32"
    },
    "scene_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scene_weather": {
      "type": "string"
    },
    "scene_weather_intensity": {
      "type": "number",
      "format": "double"
    },
    "scene_x": {
      "type": "number",
      "format": "double"
    },
    "scene_y": {
      "type": "number",
      "format": "double"
    },
    "scene_yaw": {
      "type": "number",
      "format": "double"
    },
    "scene_z": {
      "type": "number",
      "format": "double"
    },
    "shader_id": {
      "type": "string"
    },
    "shader_name": {
      "type": "string"
    },
    "shader_slug": {
      "type": "string"
    },
    "shader_version_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "world_file_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "world_file_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "world_id": {
      "type": "string"
    },
    "world_name": {
      "type": "string"
    },
    "world_size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "world_slug": {
      "type": "string"
    },
    "world_version_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "shader_version_id",
    "shader_id",
    "shader_slug",
    "shader_name",
    "version",
    "scene_id",
    "scene_slug",
    "scene_name",
    "scene_dimension",
    "scene_x",
    "scene_y",
    "scene_z",
    "scene_yaw",
    "scene_pitch",
    "scene_time_of_day_ticks",
    "scene_weather",
    "scene_weather_intensity",
    "world_id",
    "world_slug",
    "world_name"
  ]
}