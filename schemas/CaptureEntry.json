{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureEntry",
  "type": "object",
  "properties": {
    "file": {
      "type": "string"
    },
    "resolution": {
      "$ref": "#/$defs/Resolution"
    },
    "shader": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShaderMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "file",
    "timestamp",
    "resolution"
  ],
  "$defs": {
    "Resolution": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "int32"
        },
        "width": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "ShaderMetadata": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "filename",
        "id",
        "version"
      ]
    }
  }
}