{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureSessionData",
  "type": "object",
  "properties": {
    "captures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaptureEntry"
      }
    },
    "completedAt": {
      "type": "string"
    },
    "minecraft": {
      "$ref": "#/$defs/MinecraftInfo"
    },
    "sceneId": {
      "type": "string"
    },
    "sessionDir": {
      "type": "string"
    },
    "shaders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "startedAt": {
      "type": "string"
    },
    "totalCaptures": {
      "type": "integer",
      "format": "int32"
    },
    "worldName": {
      "type": "string"
    }
  },
  "required": [
    "worldName",
    "sceneId",
    "sessionDir",
    "startedAt",
    "completedAt",
    "totalCaptures",
    "shaders",
    "minecraft",
    "captures"
  ],
  "$defs": {
    "Camera": {
      "type": "object",
      "properties": {
        "pitch": {
          "type": "number",
          "format": "double"
        },
        "yaw": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "yaw",
        "pitch"
      ]
    },
    "CaptureEntry": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "resolution": {
          "$ref": "#/$defs/Resolution"
        },
        "shader": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShaderMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "timestamp",
        "resolution"
      ]
    },
    "MinecraftInfo": {
      "type": "object",
      "properties": {
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/Camera"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimension": {
          "type": [
            "string",
            "null"
          ]
        },
        "irisVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ]
    },
    "Position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "z": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "int32"
        },
        "width": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "ShaderMetadata": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "filename",
        "id",
        "version"
      ]
    }
  }
}